msgctxt "#30000"
msgid "Player Service"
msgstr "Dịch vụ phát"

msgctxt "#30001"
msgid "Export Service"
msgstr "Dịch vụ xuất"

msgctxt "#30002"
msgid "Source Service"
msgstr "Dịch vụ nguồn"

msgctxt "#30003"
msgid "Before export to library, remove previous files and folders"
msgstr "Trước khi xuất vào thư viện, xóa các tệp và thư mục cũ"

msgctxt "#30004"
msgid "Automatically set subtitles from cloud drive"
msgstr "Tự động gắn phụ đề từ ổ đám mây"

msgctxt "#30005"
msgid "Auto-Refreshed slideshow"
msgstr "Trình chiếu ảnh tự làm mới"

msgctxt "#30006"
msgid "Refresh interval in minutes"
msgstr "Khoảng làm mới (phút)"

msgctxt "#30007"
msgid "Special: Photos"
msgstr "Đặc biệt: Ảnh"

msgctxt "#30008"
msgid "Special: Camera Roll"
msgstr "Đặc biệt: Thư mục máy ảnh"

msgctxt "#30009"
msgid "Special: Music"
msgstr "Đặc biệt: Nhạc"

msgctxt "#30010"
msgid "Recursive auto-refreshed slideshow"
msgstr "Trình chiếu tự làm mới gồm cả thư mục con"

msgctxt "#30011"
msgid "Resume playing when resume point exists in library"
msgstr "Phát tiếp khi thư viện có điểm dừng"

msgctxt "#30017"
msgid "Ask to resume if resume point exists in library"
msgstr "Hỏi phát tiếp khi thư viện có điểm dừng"

msgctxt "#30018"
msgid "Save resume points and watched status in library"
msgstr "Lưu điểm dừng và trạng thái đã xem vào thư viện"

msgctxt "#30019"
msgid "Do not include filename extension in a .strm"
msgstr "Không ghi phần mở rộng tên tệp vào .strm"

msgctxt "#30020"
msgid "Hide exporting progress dialog"
msgstr "Ẩn hộp tiến trình khi xuất"

msgctxt "#30032"
msgid "Advanced"
msgstr "Nâng cao"

msgctxt "#30034"
msgid "Cache expiration time (in minutes)"
msgstr "Thời gian lưu bộ nhớ đệm (phút)"

msgctxt "#30035"
msgid "Clear cache now"
msgstr "Xóa bộ nhớ đệm ngay"

msgctxt "#30036"
msgid "Sign in to OneDrive"
msgstr "Đăng nhập OneDrive"

msgctxt "#30037"
msgid "On your phone or computer, open the address below and enter this code."
msgstr "Trên điện thoại hoặc máy tính, mở địa chỉ bên dưới và nhập mã này."

msgctxt "#30038"
msgid "This code expires in %s"
msgstr "Mã này hết hạn sau %s"

msgctxt "#30039"
msgid "This code has expired."
msgstr "Mã này đã hết hạn."

msgctxt "#30040"
msgid "Get a new code"
msgstr "Lấy mã mới"

msgctxt "#30041"
msgid "You may be asked to sign in again on your phone. That is expected."
msgstr "Bạn có thể được yêu cầu đăng nhập lại trên điện thoại. Điều đó là bình thường."

msgctxt "#30042"
msgid "Sign in again"
msgstr "Đăng nhập lại"

msgctxt "#30043"
msgid "Sign-in needed"
msgstr "Cần đăng nhập"

msgctxt "#30044"
msgid "Sign-in failed. Error code: %s"
msgstr "Đăng nhập thất bại. Mã lỗi: %s"

msgctxt "#30045"
msgid "You can also use your own app registration: put its Client ID in this add-on's settings, under Advanced, at Expert level."
msgstr "Bạn cũng có thể dùng app registration riêng: nhập Client ID của nó trong cài đặt của add-on này, mục Nâng cao, ở cấp Chuyên gia."

msgctxt "#30046"
msgid "Your app registration is not set up for sign-in on a device. Turn on 'Allow public client flows' for it. Adding a secret will not help."
msgstr "App registration của bạn chưa được cấu hình để đăng nhập trên thiết bị. Hãy bật 'Allow public client flows' cho nó. Thêm secret sẽ không giúp gì."

msgctxt "#30047"
msgid "This app has not been given permission to read your files. Sign in again and choose Accept."
msgstr "Ứng dụng này chưa được cấp quyền đọc tệp của bạn. Hãy đăng nhập lại và chọn Accept."

msgctxt "#30048"
msgid "Your organisation must approve this app before you can use it. Ask an administrator to approve it."
msgstr "Tổ chức của bạn phải phê duyệt ứng dụng này trước khi bạn dùng được. Hãy nhờ quản trị viên phê duyệt."

msgctxt "#30049"
msgid "Your account is not assigned to this app. Ask an administrator to assign it."
msgstr "Tài khoản của bạn chưa được gán cho ứng dụng này. Hãy nhờ quản trị viên gán."

msgctxt "#30050"
msgid "Your organisation's access policy blocks sign-in from a device like this. Ask an administrator."
msgstr "Chính sách truy cập của tổ chức bạn chặn đăng nhập từ thiết bị như thế này. Hãy hỏi quản trị viên."

msgctxt "#30051"
msgid "Your organisation's security defaults block sign-in from a device like this. Ask an administrator."
msgstr "Cấu hình bảo mật mặc định của tổ chức bạn chặn đăng nhập từ thiết bị như thế này. Hãy hỏi quản trị viên."

msgctxt "#30052"
msgid "Your organisation asks for a second sign-in step. Finish it on your phone, then try again."
msgstr "Tổ chức của bạn yêu cầu bước đăng nhập thứ hai. Hoàn tất trên điện thoại rồi thử lại."

msgctxt "#30053"
msgid "Your organisation asks you to set up a second sign-in step first. Set it up on your phone, then try again."
msgstr "Tổ chức của bạn yêu cầu thiết lập bước đăng nhập thứ hai trước. Thiết lập trên điện thoại rồi thử lại."

msgctxt "#30054"
msgid "Your password has expired. Change it on your phone, then try again."
msgstr "Mật khẩu của bạn đã hết hạn. Đổi mật khẩu trên điện thoại rồi thử lại."

msgctxt "#30055"
msgid "This app is turned off in your organisation. Ask an administrator to turn it back on."
msgstr "Ứng dụng này đã bị tắt trong tổ chức của bạn. Hãy nhờ quản trị viên bật lại."

msgctxt "#30056"
msgid "This app is not registered in your organisation. Ask an administrator to add it."
msgstr "Ứng dụng này chưa được đăng ký trong tổ chức của bạn. Hãy nhờ quản trị viên thêm vào."

msgctxt "#30057"
msgid "The sign-in code was refused. Get a new code and try again."
msgstr "Mã đăng nhập bị từ chối. Lấy mã mới rồi thử lại."

msgctxt "#30058"
msgid "The sign-in code expired before it was used. Get a new code and try again."
msgstr "Mã đăng nhập đã hết hạn trước khi được dùng. Lấy mã mới rồi thử lại."

msgctxt "#30059"
msgid "You signed in as %s, which is a different account. Nothing was changed."
msgstr "Bạn đã đăng nhập bằng %s, là một tài khoản khác. Không có gì thay đổi."

msgctxt "#30067"
msgid "Services"
msgstr "Dịch vụ"

msgctxt "#30068"
msgid "Allow using OneDrive as a source"
msgstr "Cho phép dùng OneDrive làm nguồn"

msgctxt "#30069"
msgid "     Source server port  -  http://localhost:<port>/source"
msgstr "     Cổng máy chủ nguồn  -  http://localhost:<port>/source"

msgctxt "#30070"
msgid "Client ID of your own app registration"
msgstr "Client ID của app registration riêng"

msgctxt "#30071"
msgid "Leave this empty to use the registration built into the add-on. Fill it in only if your organisation blocks that one: paste the Application (client) ID of an app registration of your own. Anything that is not a valid ID is ignored and the built-in one is used."
msgstr "Để trống để dùng registration có sẵn trong add-on. Chỉ điền nếu tổ chức của bạn chặn registration đó: dán Application (client) ID của app registration của riêng bạn. Giá trị không phải ID hợp lệ sẽ bị bỏ qua và registration có sẵn được dùng."

msgctxt "#30072"
msgid "Quick access"
msgstr "Truy cập nhanh"

msgctxt "#30073"
msgid "Open the only account directly"
msgstr "Mở thẳng tài khoản duy nhất"

msgctxt "#30074"
msgid "Show the drive's folders on its first screen"
msgstr "Hiện thư mục của ổ ngay ở màn hình đầu"

msgctxt "#30075"
msgid "Open folders faster (do not count items first)"
msgstr "Mở thư mục nhanh hơn (không đếm số mục trước)"

msgctxt "#30076"
msgid "Library folder (empty: inside the add-on's data)"
msgstr "Thư mục thư viện (để trống: trong dữ liệu của add-on)"

msgctxt "#30077"
msgid "Accounts"
msgstr "Tài khoản"

msgctxt "#30078"
msgid "Set as start folder"
msgstr "Đặt làm thư mục khởi động"

msgctxt "#30079"
msgid "Reset start folder"
msgstr "Bỏ thư mục khởi động"

msgctxt "#30080"
msgid "Start folder: %s"
msgstr "Thư mục khởi động: %s"

msgctxt "#30081"
msgid "Start folder reset"
msgstr "Đã bỏ thư mục khởi động"

msgctxt "#30082"
msgid "The start folder no longer exists. Showing all files."
msgstr "Thư mục khởi động không còn tồn tại. Đang hiện tất cả tệp."

msgctxt "#30083"
msgid "Add to library as movies"
msgstr "Thêm vào thư viện dạng phim"

msgctxt "#30084"
msgid "Add to library as TV shows"
msgstr "Thêm vào thư viện dạng TV show"

msgctxt "#30085"
msgid "Added to the library. The first export starts within a minute."
msgstr "Đã thêm vào thư viện. Lần xuất đầu tiên sẽ bắt đầu trong vòng một phút."

msgctxt "#30086"
msgid "Added to the library. The first export starts within a minute.[CR][CR]One-time step: in Kodi open Videos > Files > Add videos..., browse to[CR]%s[CR]and set the content of that source to %s. New videos then reach the library by themselves."
msgstr "Đã thêm vào thư viện. Lần xuất đầu tiên sẽ bắt đầu trong vòng một phút.[CR][CR]Bước làm một lần: trong Kodi mở Videos > Files > Add videos..., duyệt tới[CR]%s[CR]và đặt loại nội dung của nguồn đó là %s. Từ đó video mới sẽ tự vào thư viện."

msgctxt "#30087"
msgid "This folder is already in the library. Its settings are under Exports."
msgstr "Thư mục này đã có trong thư viện. Cài đặt của nó nằm trong mục Xuất."

msgctxt "#30088"
msgid "Another folder called %s is already in this part of the library. Rename one of them on OneDrive first."
msgstr "Đã có một thư mục khác tên %s trong phần thư viện này. Hãy đổi tên một trong hai trên OneDrive trước."

msgctxt "#30089"
msgid "The library folder already holds a folder called %s that this add-on did not create, so it was left alone."
msgstr "Thư mục thư viện đã có một thư mục tên %s không do add-on này tạo, nên nó được giữ nguyên."

msgctxt "#30090"
msgid "Only a folder can be added to the library."
msgstr "Chỉ có thể thêm thư mục vào thư viện."

msgctxt "#30091"
msgid "All files"
msgstr "Tất cả tệp"

msgctxt "#30092"
msgid "Latest videos"
msgstr "Video mới nhất"

msgctxt "#30093"
msgid "Refresh this folder"
msgstr "Làm mới thư mục này"

msgctxt "#30094"
msgid "Keep folder listings for (minutes, 0 = always ask OneDrive)"
msgstr "Giữ danh sách thư mục trong (phút, 0 = luôn hỏi OneDrive)"

msgctxt "#30095"
msgid "Sharper thumbnails (for poster and wall views)"
msgstr "Ảnh thu nhỏ sắc nét hơn (cho giao diện Poster và Wall)"

msgctxt "#30096"
msgid "Set up the library folders as Kodi video sources automatically"
msgstr "Tự động thiết lập thư mục thư viện thành nguồn video của Kodi"

msgctxt "#30097"
msgid "Added to the library. The videos appear in Videos > %s a few minutes after the first export. The folder itself shows under Videos > Files after Kodi restarts."
msgstr "Đã thêm vào thư viện. Video sẽ xuất hiện trong Video > %s vài phút sau lần xuất đầu tiên. Bản thân thư mục sẽ hiện trong Video > Tệp sau khi khởi động lại Kodi."

msgctxt "#30098"
msgid "One TV show (seasons or episodes inside)"
msgstr "Một bộ phim (bên trong là các mùa hoặc các tập)"

msgctxt "#30099"
msgid "A folder of TV shows (one show per subfolder)"
msgstr "Thư mục chứa nhiều bộ phim (mỗi thư mục con là một bộ)"

msgctxt "#30100"
msgid "What does %s hold?"
msgstr "%s chứa gì?"

msgctxt "#30101"
msgid "OneDrive movies"
msgstr "Phim lẻ OneDrive"

msgctxt "#30102"
msgid "OneDrive TV shows"
msgstr "Phim bộ OneDrive"

msgctxt "#32000"
msgid "Exports"
msgstr "Xuất"

msgctxt "#32001"
msgid "Export of '%s' will be removed. Are you sure?"
msgstr "Bản xuất '%s' sẽ bị xóa. Bạn chắc chứ?"

msgctxt "#32002"
msgid "Select destination folder"
msgstr "Chọn thư mục đích"

msgctxt "#32003"
msgid "Run export now"
msgstr "Xuất ngay"

msgctxt "#32004"
msgid "Export to .strm files..."
msgstr "Xuất ra tệp .strm..."

msgctxt "#32005"
msgid "Add an account..."
msgstr "Thêm tài khoản..."

msgctxt "#32006"
msgid "Remove Account..."
msgstr "Xóa tài khoản..."

msgctxt "#32007"
msgid "Remove Drive..."
msgstr "Xóa ổ..."

msgctxt "#32008"
msgid "Connecting with server, please wait..."
msgstr "Đang kết nối tới máy chủ, vui lòng chờ..."

msgctxt "#32009"
msgid "Scan the QR code and sign in."
msgstr "Quét mã QR và đăng nhập."

msgctxt "#32010"
msgid "or[CR]Go to this URL: %s[CR]enter the code and sign in: %s"
msgstr "hoặc[CR]Vào địa chỉ: %s[CR]nhập mã và đăng nhập: %s"

msgctxt "#32011"
msgid "Expires in %s seconds..."
msgstr "Hết hạn sau %s giây..."

msgctxt "#32012"
msgid "Yes! Count me in"
msgstr "Có! Tôi tham gia"

msgctxt "#32013"
msgid "No"
msgstr "Không"

msgctxt "#32014"
msgid "Retrieving credentials..."
msgstr "Đang lấy thông tin đăng nhập..."

msgctxt "#32015"
msgid "Unable to login:"
msgstr "Không thể đăng nhập:"

msgctxt "#32016"
msgid "Please try again."
msgstr "Vui lòng thử lại."

msgctxt "#32017"
msgid "Retrieving drive information..."
msgstr "Đang lấy thông tin ổ..."

msgctxt "#32018"
msgid "Unable to retrieve the drive information:"
msgstr "Không thể lấy thông tin ổ:"

msgctxt "#32019"
msgid "The access to this resource has been denied. You might not have enough permission"
msgstr "Truy cập tài nguyên này bị từ chối. Có thể bạn không đủ quyền"

msgctxt "#32020"
msgid "Adding account..."
msgstr "Đang thêm tài khoản..."

msgctxt "#32021"
msgid "Unable to add account:"
msgstr "Không thể thêm tài khoản:"

msgctxt "#32022"
msgid "Account '%s' will be removed. Are you sure?"
msgstr "Tài khoản '%s' sẽ bị xóa. Bạn chắc chứ?"

msgctxt "#32023"
msgid "Drive '%s' will be removed. Are you sure?"
msgstr "Ổ '%s' sẽ bị xóa. Bạn chắc chứ?"

msgctxt "#32024"
msgid "exporting"
msgstr "đang xuất"

msgctxt "#32025"
msgid "Starting, please wait..."
msgstr "Đang bắt đầu, vui lòng chờ..."

msgctxt "#32026"
msgid "The destination folder '%s' is invalid. It does not exist."
msgstr "Thư mục đích '%s' không hợp lệ. Nó không tồn tại."

msgctxt "#32027"
msgid "Unknown error:"
msgstr "Lỗi không xác định:"

msgctxt "#32028"
msgid "Unable to move your previous accounts information file. Please move it manually to %s or add your accounts again."
msgstr "Không thể di chuyển tệp thông tin tài khoản cũ. Hãy tự chuyển nó tới %s hoặc thêm lại tài khoản."

msgctxt "#32029"
msgid "Need help? Go to the forum and post a message in: kodi.daro.mx/forum"
msgstr "Cần trợ giúp? Vào diễn đàn và đăng bài tại: kodi.daro.mx/forum"

msgctxt "#32030"
msgid "Collaboration"
msgstr "Cộng tác"

msgctxt "#32031"
msgid "Report errors automatically to help resolve them quickly"
msgstr "Tự động báo lỗi để giúp sửa nhanh"

msgctxt "#32032"
msgid "Auto-Refreshed slideshow"
msgstr "Trình chiếu ảnh tự làm mới"

msgctxt "#32033"
msgid "Yes"
msgstr "Có"

msgctxt "#32034"
msgid "'%s' is not a folder"
msgstr "'%s' không phải là thư mục"

msgctxt "#32035"
msgid "The server is temporary unavailable for this operation."
msgstr "Máy chủ tạm thời không phục vụ được thao tác này."

msgctxt "#32036"
msgid "Something went wrong with this operation."
msgstr "Đã có lỗi xảy ra với thao tác này."

msgctxt "#32037"
msgid "File or folder not found. Make sure is still in your drive."
msgstr "Không tìm thấy tệp hoặc thư mục. Hãy kiểm tra nó còn trong ổ của bạn."

msgctxt "#32038"
msgid "Please try again later."
msgstr "Vui lòng thử lại sau."

msgctxt "#32039"
msgid "Search..."
msgstr "Tìm kiếm..."

msgctxt "#32040"
msgid "Searching '%s', please wait..."
msgstr "Đang tìm '%s', vui lòng chờ..."

msgctxt "#32041"
msgid "Processing results, please wait..."
msgstr "Đang xử lý kết quả, vui lòng chờ..."

msgctxt "#32042"
msgid "Enter text to search:"
msgstr "Nhập nội dung cần tìm:"

msgctxt "#32043"
msgid "Something happened with the request%s."
msgstr "Đã có sự cố với yêu cầu%s."

msgctxt "#32044"
msgid "Will try in %s seconds."
msgstr "Sẽ thử lại sau %s giây."

msgctxt "#32045"
msgid "Attempt %s of %s."
msgstr "Lần thử %s trên %s."

msgctxt "#32046"
msgid "The credentials for '%s' are no longer valid. You need to sign in again.%sDo you want to start the process?"
msgstr "Thông tin đăng nhập của '%s' không còn hợp lệ. Bạn cần đăng nhập lại.%sBạn có muốn bắt đầu không?"

msgctxt "#32047"
msgid "%s of %s items loaded, please wait..."
msgstr "Đã tải %s trên %s mục, vui lòng chờ..."

msgctxt "#32048"
msgid "%s items loaded, please wait..."
msgstr "Đã tải %s mục, vui lòng chờ..."

msgctxt "#32049"
msgid "Loading %s items in this folder, please wait..."
msgstr "Đang tải %s mục trong thư mục này, vui lòng chờ..."

msgctxt "#32050"
msgid "Do you want to help reporting errors to resolve them quickly?"
msgstr "Bạn có muốn giúp báo lỗi để sửa nhanh hơn không?"

msgctxt "#32051"
msgid "Download"
msgstr "Tải xuống"

msgctxt "#32052"
msgid "Files"
msgstr "Tệp"

msgctxt "#32053"
msgid "Recent"
msgstr "Gần đây"

msgctxt "#32054"
msgid "Resume from %s"
msgstr "Phát tiếp từ %s"

msgctxt "#32055"
msgid "Export will start in less than %s seconds"
msgstr "Việc xuất sẽ bắt đầu trong chưa đầy %s giây"

msgctxt "#32056"
msgid "Downloading %s"
msgstr "Đang tải %s"

msgctxt "#32057"
msgid "File %s downloaded"
msgstr "Đã tải xong tệp %s"

msgctxt "#32058"
msgid "Shared With Me"
msgstr "Được chia sẻ với tôi"

msgctxt "#32059"
msgid "Exporting task already in progress."
msgstr "Một tác vụ xuất đang chạy."

msgctxt "#32060"
msgid "Searching subtitle file %s, please wait..."
msgstr "Đang tìm tệp phụ đề %s, vui lòng chờ..."

msgctxt "#32061"
msgid "Subtitle found! Playing this video with subtitle..."
msgstr "Đã tìm thấy phụ đề! Đang phát video kèm phụ đề..."

msgctxt "#32062"
msgid "Subtitle not found for this video"
msgstr "Không tìm thấy phụ đề cho video này"

msgctxt "#32063"
msgid "This account or drive is not registered.%sDo you want to add an account?"
msgstr "Tài khoản hoặc ổ này chưa được đăng ký.%sBạn có muốn thêm tài khoản không?"

msgctxt "#32064"
msgid "Retrieving owner information..."
msgstr "Đang lấy thông tin chủ sở hữu..."

