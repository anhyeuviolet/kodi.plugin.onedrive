/.settings/
/.idea/
/env/
*.pyc
*.pyo

# Generated by .planning/research/url_latch_probe.py
.planning/research/latch-probe-media.mp4
.planning/research/latch-probe.strm
.planning/research/.cache/
.planning/research/url-lifetime-results.log

# Failing sign-in responses captured by .planning/research/verify_device_code.py.
# The whole response body is kept unredacted, because the fields a redactor
# would strip are the ones that diagnose it -- which is exactly why the file
# must never reach the index. One per failure, named by the moment it happened.
.planning/research/device-code-failure-*.json

# The scratch profile a live sign-in harness writes real tokens into. Belongs
# outside the tree entirely; this is the second line of defence, not the first.
.planning/research/live-scratch/

# Test-run artefacts
__pycache__/
.pytest_cache/

# Default output of tools/build_addon_zip.py. Kept out of the index because the
# index is what the build reads: a committed archive would be shipped inside the
# next one.
/dist/
